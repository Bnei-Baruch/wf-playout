# State database - used in PlayOut.js and PlayBrowser.js for playlist management
REACT_APP_JSDB_STATE=https://shidur.kab.info/db

# Workflow backend - used in PlayBrowser.js for getting workflow data
REACT_APP_JSRP_BACKEND=https://wf.kab.info/wfdb

# Galaxy backend - used in tools.js for getting rooms
REACT_APP_GXY_BACKEND=https://wf.kab.info/wfdb/rooms

# Service API - used in tools.js for service calls
REACT_APP_SRV_URL=https://wf.kab.info/wfdb/service

# Proxy backend - used in tools.js for proxy requests
REACT_APP_PROXY_BACKEND=https://wf.kab.info/wfdb/proxy

# Live stream URL - used in tools.js for getting live stream manifests
REACT_APP_LIVE_URL=https://live.kab.info

# MQTT broker - used in mqtt.js for WebSocket connection (wss://)
REACT_APP_MQTT_LCL_URL=mqtt.bbdomain.org

# MDB unit URL - used in PlayBrowser.js for linking to content units
REACT_APP_MDB_UNIT_URL=https://kabbalahmedia.info/mdb-api/content_units

# Network targets - used in tools.js for RTP/RTMP destination options
REACT_APP_PIRATI=10.0.0.1
REACT_APP_TEST=10.0.0.2
REACT_APP_MERKAZ_MAIN=10.0.0.3
REACT_APP_MERKAZ_BACKUP=10.0.0.4
REACT_APP_VPN_MAIN=10.0.0.5
REACT_APP_VPN_BACKUP=10.0.0.6
REACT_APP_DECODER_MAIN=10.0.0.7
REACT_APP_DECODER_BACKUP=10.0.0.8
REACT_APP_DECODER_TEST=10.0.0.9

# STUN server - used in tools.js for WebRTC
REACT_APP_STUN_SRV_GXY=stun:stun.l.google.com:19302
